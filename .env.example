# Flash arbitrage bot environment template
# Copy to .env or your local shell and fill real values from 1Password item: BOT.
# Never commit real RPC URLs, private keys, seed material, or API keys.

# Network RPC providers
# Provider URLs for each supported chain. Use HTTPS endpoints with project credentials.
QUICKNODE_ARBITRUM_HTTP=
QUICKNODE_BASE_HTTP=
QUICKNODE_POLYGON_HTTP=

# Optional Ethereum mainnet fork settings used by Hardhat.
MAINNET_FORK_URL=
FORK_BLOCK_NUMBER=
ALCHEMY_API_KEY=

# Wallets and key material
# Server-only/private signing key for local deployment or bot operations.
PRIVATE_KEY=

# Deployed arbitrage contracts
ARBITRAGE_CONTRACT_ARBITRUM=
ARBITRAGE_CONTRACT_BASE=
ARBITRAGE_CONTRACT_POLYGON=

# Contract verification
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
POLYGONSCAN_API_KEY=

# Deployment scripts
# Set to true to run verification after deployment.
VERIFY=false
